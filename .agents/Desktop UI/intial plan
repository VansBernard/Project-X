<!-- Branding Content -->
<div class="relative z-10 flex flex-col items-center text-center px-12">
<div class="mb-sm flex items-center justify-center bg-primary-container text-on-primary-container p-sm rounded-xl">
<span class="material-symbols-outlined text-[48px]" style="font-variation-settings: 'FILL' 1;">security</span>
</div>
<h1 class="font-display text-display text-on-error mb-xs">Project X</h1>
<p class="font-body-lg text-body-lg text-surface-variant mb-xl">Device Management &amp; Licensing</p>
<div class="h-[1px] w-16 bg-surface-variant/30 mb-xl"></div>
<p class="font-label-md text-label-md text-tertiary-fixed-dim uppercase tracking-wider">Secure. Activate. Work.</p>
</div>
</div>
<!-- Split Screen Layout: Right Login Form Panel -->
<div class="w-full lg:w-1/2 flex flex-col items-center justify-center bg-surface-container-lowest relative px-sm sm:px-lg lg:px-xl py-xl pb-32 lg:pb-xl">
<div class="w-full max-w-[400px]">
<!-- Header -->
<div class="text-center mb-xl">
<h2 class="font-headline-lg text-headline-lg text-on-surface mb-xs">Welcome Back</h2>
<p class="font-body-md text-body-md text-on-surface-variant">Sign in to continue to Project X</p>
</div>
<!-- Form -->
<form class="space-y-sm">
<!-- Email Field -->
<div class="relative group">
<span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-on-surface-variant group-focus-within:text-primary transition-colors">person</span>
<input class="w-full pl-xl pr-sm py-3 rounded-lg border border-outline-variant bg-surface-container-lowest font-body-md text-body-md text-on-surface placeholder:text-outline focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Email or Phone Number" required="" type="email"/>
</div>
<!-- Password Field -->
<div class="relative group">
<span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-on-surface-variant group-focus-within:text-primary transition-colors">lock</span>
<input class="w-full pl-xl pr-xl py-3 rounded-lg border border-outline-variant bg-surface-container-lowest font-body-md text-body-md text-on-surface placeholder:text-outline focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Password" required="" type="password"/>
<button class="absolute right-sm top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors focus:outline-none" type="button">
<span class="material-symbols-outlined text-[20px]">visibility</span>
</button>
</div>
<!-- Options Row -->
<div class="flex items-center justify-between pt-xs pb-sm">
<label class="flex items-center gap-xs cursor-pointer group">
<div class="relative flex items-center justify-center w-5 h-5 rounded border border-outline-variant bg-surface-container-lowest group-hover:border-primary transition-colors">
<input checked="" class="opacity-0 absolute w-full h-full cursor-pointer peer" type="checkbox"/>
<span class="material-symbols-outlined text-[16px] text-primary opacity-0 peer-checked:opacity-100 transition-opacity">check</span>
</div>
<span class="font-body-md text-body-md text-on-surface">Remember me</span>
</label>
<a class="font-label-md text-label-md text-primary hover:text-on-primary-fixed-variant transition-colors" href="#">Forgot password?</a>
</div>
<!-- Primary Action -->
<button class="w-full bg-primary-container text-on-primary-container font-label-md text-label-md py-3 rounded-lg flex items-center justify-center gap-xs hover:bg-primary transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-primary-container shadow-sm" type="submit">
<span class="material-symbols-outlined text-[18px]">lock_open</span>
                    Sign In
                </button>
<!-- Divider -->
<div class="relative flex items-center py-sm">
<div class="flex-grow border-t border-outline-variant"></div>
<span class="flex-shrink-0 mx-4 font-label-md text-label-md text-on-surface-variant">or</span>
<div class="flex-grow border-t border-outline-variant"></div>
</div>
<!-- Secondary Action (SSO) -->
<button class="w-full bg-surface-container-lowest text-on-surface border border-outline-variant font-label-md text-label-md py-3 rounded-lg flex items-center justify-center gap-xs hover:bg-surface-container-low transition-colors" type="button">
<span class="material-symbols-outlined text-[18px] text-[#00a4ef]">grid_view</span>
                    Sign in with Windows
                </button>
</form>
<!-- Bottom Action -->
<div class="mt-lg text-center">
<p class="font-body-md text-body-md text-on-surface-variant">
                    Don't have an account? 
                    <a class="text-primary hover:text-on-primary-fixed-variant font-label-md text-label-md transition-colors" href="#">Create one</a>
</p>
</div>
