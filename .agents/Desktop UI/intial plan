<body class="bg-surface text-on-surface min-h-screen flex antialiased">
<!-- Split Screen Layout: Left Branding Panel (Hidden on Mobile) -->
<div class="hidden lg:flex w-1/2 bg-inverse-surface relative overflow-hidden flex-col items-center justify-center">
