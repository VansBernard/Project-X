<Window x:Class="ProjectX.LockScreen.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Status" 
        Width="700" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a"
        Foreground="White"
        ResizeMode="CanResize"
        WindowStyle="ThreeDBorderWindow">
    
    <Grid Background="#0d0d0d">
        <DockPanel LastChildFill="True">
            
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="#1a1a1a" BorderThickness="0,0,0,1" BorderBrush="#333333" Padding="20,15">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="#FF6B35">
                        📊 Device Status
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#999999" Margin="0,5,0,0">
                        <Run Text="{Binding DeviceId}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Footer with Action Buttons -->
            <Border DockPanel.Dock="Bottom" Background="#1a1a1a" BorderThickness="0,1,0,0" BorderBrush="#333333" Padding="20,15">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <Button Grid.Column="1"
                            Content="🔄 Sync Now"
                            Command="{Binding SyncCommand}"
                            Background="#4A90E2"
                            Foreground="White"
                            Padding="15,8"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBooleanConverter}}"
                            Cursor="Hand"/>

                    <Button Grid.Column="2"
                            Content="Close"
                            Command="{Binding CloseCommand}"
                            Background="#666666"
                            Foreground="White"
                            Padding="15,8"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Padding="25">

                    <!-- Warnings Section -->
                    <StackPanel Spacing="10">
                        <!-- Lock Warning -->
                        <Border Background="#4C1414" Padding="15" CornerRadius="5"
                                Visibility="{Binding ShowLockWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#FF4444">
                                    ⚠️ Device Lock Status
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#FF9999" TextWrapping="Wrap" Margin="0,5,0,0">
                                    <Run Text="{Binding LockWarning}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Expiration Warning -->
                        <Border Background="#4C3A14" Padding="15" CornerRadius="5"
                                Visibility="{Binding ShowExpirationWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#FFCC66">
                                    ⏰ License Expiration
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#FFDD99" TextWrapping="Wrap" Margin="0,5,0,0">
                                    <Run Text="{Binding ExpirationWarning}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- License Information -->
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#CCCCCC">
                            📋 License Information
                        </TextBlock>
                        <Border Background="#2a2a2a" Padding="15" CornerRadius="5">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15" RowSpacing="10">
                                <!-- License ID -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#999999" FontWeight="Bold">License ID:</TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1" Foreground="#CCCCCC">
                                    <Run Text="{Binding LicenseInfo.LicenseId, FallbackValue='Not Available'}"/>
                                </TextBlock>

                                <!-- Contract ID -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#999999" FontWeight="Bold">Contract ID:</TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#CCCCCC">
                                    <Run Text="{Binding LicenseInfo.ContractId, FallbackValue='Not Available'}"/>
                                </TextBlock>

                                <!-- Device ID -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Foreground="#999999" FontWeight="Bold">Device ID:</TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1" Foreground="#CCCCCC">
                                    <Run Text="{Binding LicenseInfo.DeviceId, FallbackValue='Not Available'}"/>
                                </TextBlock>

                                <!-- Status -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Foreground="#999999" FontWeight="Bold">Status:</TextBlock>
                                <TextBlock Grid.Row="3" Grid.Column="1" Foreground="#AADD66">
                                    <Run Text="{Binding LicenseInfo.Status, FallbackValue='Unknown'}"/>
                                </TextBlock>

                                <!-- Issued -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Foreground="#999999" FontWeight="Bold">Issued:</TextBlock>
                                <TextBlock Grid.Row="4" Grid.Column="1" Foreground="#CCCCCC">
                                    <Run Text="{Binding LicenseInfo.IssuedAt, StringFormat='g', FallbackValue='Not Available'}"/>
                                </TextBlock>

                                <!-- Expires -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Foreground="#999999" FontWeight="Bold">Expires:</TextBlock>
                                <TextBlock Grid.Row="5" Grid.Column="1" Foreground="#CCCCCC">
                                    <Run Text="{Binding LicenseInfo.ExpiresAt, StringFormat='g', FallbackValue='Not Available'}"/>
                                </TextBlock>

                                <!-- Days Remaining -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Foreground="#999999" FontWeight="Bold">Days Remaining:</TextBlock>
                                <TextBlock Grid.Row="6" Grid.Column="1" Foreground="#AADD66" FontWeight="Bold">
                                    <Run Text="{Binding LicenseInfo.DaysRemaining, FallbackValue='?'}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Device Lock Information -->
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#CCCCCC">
                            🔒 Device Lock Status
                        </TextBlock>
                        <Border Background="#2a2a2a" Padding="15" CornerRadius="5">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15" RowSpacing="10">
                                <!-- Locked Status -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#999999" FontWeight="Bold">Status:</TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                          Foreground="{Binding DeviceLockInfo.IsLocked, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FF4444|#66DD66'}">
                                    <Run Text="{Binding DeviceLockInfo.IsLocked, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Locked|Unlocked'}"/>
                                </TextBlock>

                                <!-- Reason (if locked) -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#999999" FontWeight="Bold"
                                          Visibility="{Binding DeviceLockInfo.IsLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                    Reason:
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#CCCCCC"
                                          Text="{Binding DeviceLockInfo.Reason, FallbackValue='Not Available'}"
                                          Visibility="{Binding DeviceLockInfo.IsLocked, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Recovery Action -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Foreground="#999999" FontWeight="Bold"
                                          Visibility="{Binding DeviceLockInfo.IsLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                    Required Action:
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1" Foreground="#FFDD99" TextWrapping="Wrap"
                                          Text="{Binding DeviceLockInfo.RecoveryAction, FallbackValue='Not Available'}"
                                          Visibility="{Binding DeviceLockInfo.IsLocked, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Tampering -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Foreground="#999999" FontWeight="Bold">Tampering Detected:</TextBlock>
                                <TextBlock Grid.Row="3" Grid.Column="1" 
                                          Foreground="{Binding DeviceLockInfo.TamperingDetected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FF4444|#66DD66'}">
                                    <Run Text="{Binding DeviceLockInfo.TamperingDetected, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Yes|No'}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
