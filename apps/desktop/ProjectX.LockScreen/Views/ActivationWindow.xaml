<Window x:Class="ProjectX.LockScreen.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Recovery" 
        Width="650" Height="550"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a"
        Foreground="White"
        ResizeMode="NoResize"
        WindowStyle="None">
    
    <Grid Background="#0d0d0d">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="20" Width="550" Padding="25">
            
                <!-- Title -->
                <TextBlock FontSize="28" FontWeight="Bold" Foreground="#FF6B35" TextAlignment="Center">
                    🔓 Device Recovery
                </TextBlock>

                <!-- Lock Alert -->
                <Border Background="#4C1414" Padding="15" CornerRadius="5">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#FF4444">
                            ⚠️ Device is Locked
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#FF9999" TextWrapping="Wrap">
                            <Run Text="{Binding LockInfo.Reason, FallbackValue='Your device has been locked due to security concerns.'}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Recovery Instructions -->
                <Border Background="#2A3A4A" Padding="15" CornerRadius="5">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#CCCCCC">
                            Recovery Instructions:
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" LineHeight="18">
                            <Run>1. Make sure you have an active internet connection</Run>
                            <LineBreak/>
                            <Run>2. Click "Attempt Recovery" to connect with the server</Run>
                            <LineBreak/>
                            <Run>3. Verify your license status online</Run>
                            <LineBreak/>
                            <Run>4. Device will unlock once verification is complete</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Recovery Token (if available) -->
                <Border Background="#2C4C1A" Padding="15" CornerRadius="5">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#99DD66">
                            Recovery Token (Keep Safe):
                        </TextBlock>
                        <TextBox Text="{Binding RecoveryToken}"
                                 Background="#1a1a1a"
                                 Foreground="#99DD66"
                                 BorderThickness="1"
                                 BorderBrush="#66AA44"
                                 Padding="10,8"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 FontFamily="Courier New"
                                 FontSize="9"/>
                        <TextBlock FontSize="10" Foreground="#666666">
                            This token can be used for manual recovery if needed
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Recovery Status -->
                <TextBlock FontSize="12" Foreground="#CCCCCC" TextAlignment="Center" TextWrapping="Wrap">
                    <Run Text="{Binding RecoveryStatus}"/>
                </TextBlock>

                <!-- Success Indicator -->
                <Border Background="#1A4C1A" Padding="15" CornerRadius="5"
                        Visibility="{Binding RecoverySuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#66DD66" TextAlignment="Center">
                            ✓ Device Recovered
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#99DD99" TextAlignment="Center">
                            You can now use your device
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Content="Attempt Recovery"
                            Command="{Binding AttemptRecoveryCommand}"
                            Background="#4A90E2"
                            Foreground="White"
                            Padding="10,12"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding IsRecovering, Converter={StaticResource InverseBooleanConverter}}"
                            Cursor="Hand"/>

                    <Button Grid.Column="1"
                            Content="Contact Support"
                            Command="{Binding ContactSupportCommand}"
                            Background="#666666"
                            Foreground="White"
                            Padding="10,12"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </Grid>

                <!-- Back Button -->
                <Button Content="← Back"
                        Command="{Binding BackCommand}"
                        Background="#3a3a3a"
                        Foreground="White"
                        Padding="10,10"
                        Cursor="Hand"
                        HorizontalAlignment="Left"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
