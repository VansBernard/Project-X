<Window x:Class="ProjectX.LockScreen.Views.LockScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project X - Device Locked" 
        Width="600" Height="400"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a"
        Foreground="White"
        ResizeMode="NoResize"
        WindowStyle="None">
    
    <Grid Background="#0d0d0d" ShowGridLines="False">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="25" Width="500">
            
            <!-- Title -->
            <TextBlock FontSize="32" FontWeight="Bold" Foreground="#FF6B35" TextAlignment="Center">
                🔒 Device Locked
            </TextBlock>

            <!-- Device ID -->
            <TextBlock FontSize="14" Foreground="#999999" TextAlignment="Center">
                <Run Text="{Binding DeviceId}"/>
            </TextBlock>

            <!-- Tampering Warning -->
            <Border Background="#4C1414" Padding="15" CornerRadius="5" 
                    Visibility="{Binding IsDeviceTampered, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#FF4444" TextAlignment="Center">
                        ⚠️ Security Alert
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#FF9999" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0">
                        <Run Text="{Binding TamperingMessage}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Status Message -->
            <TextBlock FontSize="14" Foreground="#CCCCCC" TextAlignment="Center" TextWrapping="Wrap">
                <Run Text="{Binding Status}"/>
            </TextBlock>

            <!-- License Required Notice -->
            <Border Background="#2C4C1A" Padding="15" CornerRadius="5">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#AADD66" TextAlignment="Center" TextWrapping="Wrap">
                        Your license has expired or is missing. 
                        Please enter your license information to unlock this device.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Grid.Column="0" 
                        Content="Enter License"
                        Command="{Binding EntryLicenseCommand}"
                        Background="#FF6B35"
                        Foreground="White"
                        Padding="10,10"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
                
                <Button Grid.Column="1"
                        Content="Recover Device"
                        Command="{Binding ShowStatusCommand}"
                        Background="#4A90E2"
                        Foreground="White"
                        Padding="10,10"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>

                <Button Grid.Column="2"
                        Content="View Details"
                        Background="#666666"
                        Foreground="White"
                        Padding="10,10"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
            </Grid>

            <!-- Help Text -->
            <TextBlock FontSize="11" Foreground="#666666" TextAlignment="Center">
                Connect to network to sync and restore access
            </TextBlock>

        </StackPanel>
    </Grid>
</Window>
