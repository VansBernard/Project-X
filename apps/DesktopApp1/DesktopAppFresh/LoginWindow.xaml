<Window x:Class="DesktopAppFresh.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project X - Secure Login"
        Height="700"
        Width="1100"
        MinHeight="620"
        MinWidth="960"
        Background="#EEF0F2"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="BrandBlue" Color="#061538"/>
        <SolidColorBrush x:Key="BrandBlueSoft" Color="#0B204B"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#003EC7"/>
        <SolidColorBrush x:Key="PrimaryBlueStrong" Color="#1765ED"/>
        <SolidColorBrush x:Key="SurfaceWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSoft" Color="#F8F9FF"/>
        <SolidColorBrush x:Key="InputBorder" Color="#D3E4FE"/>
        <SolidColorBrush x:Key="TextDark" Color="#0B1C30"/>
        <SolidColorBrush x:Key="TextMuted" Color="#434656"/>
        <SolidColorBrush x:Key="TextSoft" Color="#DCE7FF"/>
        <SolidColorBrush x:Key="BorderNeutral" Color="#E5EEFF"/>


        <Style x:Key="LoginInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#F8F9FF"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10,44,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#F8F9FF"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10,44,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#EEF0F2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource BrandBlue}"
                ClipToBounds="True">
            <Grid>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#07183D" Offset="0"/>
                            <GradientStop Color="#061538" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border Opacity="0.78">
                    <Border.Background>
                        <ImageBrush ImageSource="/photo-1782729433827-b5d43a30973f.png"
                                    Stretch="UniformToFill"
                                    AlignmentX="Center"
                                    AlignmentY="Center"/>
                    </Border.Background>
                </Border>

                <Border Background="#44061538"/>

                <Grid Margin="56,44,56,44">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Width="72" Height="72" CornerRadius="18" Background="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Image Source="/Project X.png" Width="56" Height="56" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Project X"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Device Management &amp; Licensing"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="18"
                                   Foreground="{StaticResource TextSoft}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,28"/>

                        <Rectangle Width="64" Height="1" Fill="#DCE7FF" Opacity="0.5" HorizontalAlignment="Center"/>

                        <TextBlock Text="SECURE. ACTIVATE. WORK."
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="12"
                                   Foreground="#FFFFFF"
                                   FontWeight="600"
                                   HorizontalAlignment="Center"
                                   Margin="0,24,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <StackPanel>
                    <TextBlock Text="Let's Get Started"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Enter your credentials to proceed"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="14"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,28"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,12,0"/>
                        <TextBox x:Name="UsernameTextBox"
                                 Grid.Column="1"
                                 Style="{StaticResource LoginInputBox}"
                                 Margin="0,0,0,0"/>
                        <TextBlock x:Name="UsernamePlaceholderText"
                                   Grid.Column="1"
                                   Text="Dealer name"
                                   IsHitTestVisible="False"
                                   Foreground="#7D8799"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="12,0,44,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE715;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,12,0"/>
                        <TextBox x:Name="EmailTextBox"
                                 Grid.Column="1"
                                 Style="{StaticResource LoginInputBox}"
                                 Margin="0,0,0,0"/>
                        <TextBlock x:Name="EmailPlaceholderText"
                                   Grid.Column="1"
                                   Text="Email address"
                                   IsHitTestVisible="False"
                                   Foreground="#7D8799"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="12,0,44,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,12,0"/>
                        <Grid Grid.Column="1">
                            <PasswordBox x:Name="PasswordInput"
                                         Style="{StaticResource LoginPasswordBox}"/>
                            <TextBox x:Name="PasswordVisibleTextBox"
                                     Style="{StaticResource LoginInputBox}"
                                     Visibility="Collapsed"
                                     IsReadOnly="False"/>
                            <TextBlock x:Name="PasswordPlaceholderText"
                                       Text="Password"
                                       IsHitTestVisible="False"
                                       Foreground="#7D8799"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="12,0,44,0"/>
                            <Button x:Name="TogglePasswordButton"
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="👁"
                                    Foreground="{StaticResource TextMuted}"
                                    Click="TogglePasswordVisibility_Click"/>
                        </Grid>
                    </Grid>

                    <TextBlock Text="Forgot password?"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource PrimaryBlueStrong}"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="13"
                               FontWeight="600"
                               Margin="0,0,0,22"/>

                    <Button x:Name="LoginBtn"
                            Style="{StaticResource LoginPrimaryButton}"
                            Content="Sign In"
                            HorizontalAlignment="Stretch"
                            Click="LoginBtn_Click"/>

                    <TextBlock x:Name="LoginInfoText"
                               Text=""
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="12"
                               TextAlignment="Center"
                               Margin="0,18,0,0"/>

                    <TextBlock Margin="0,18,0,0"
                               TextAlignment="Center"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="14"
                               Foreground="{StaticResource TextMuted}">
                        <Run Text="Don't have an account? "/>
                        <Run Foreground="{StaticResource PrimaryBlueStrong}" Text="Create one"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{StaticResource BorderNeutral}" BorderThickness="0,1,0,0" Background="#FFFFFF">
                <Grid Margin="24,12,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="v1.0.0"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="12"/>
                    <TextBlock Grid.Column="1"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="12"
                               Text="🔒 Secure Connection"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
