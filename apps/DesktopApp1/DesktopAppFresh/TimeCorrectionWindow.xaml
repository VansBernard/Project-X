<Window x:Class="DesktopAppFresh.TimeCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Correct device time"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#F7F8FA">
    <Border Margin="18" Padding="28" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14">
        <StackPanel>
            <TextBlock Text="Date and time need attention" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold" Foreground="#16181D" />
            <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="14" Foreground="#4B5563" />
            <Border Margin="0,18,0,0" Padding="14" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8">
                <TextBlock Text="Please ask the dealer to fix the Windows date, time, and time zone, then restart Project X." TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#9A3412" />
            </Border>
            <StackPanel Margin="0,22,0,0">
                <Button Height="42" Content="Open Windows date and time settings" Click="OpenDateTimeSettingsButton_Click" Background="#246BFE" Foreground="White" BorderBrush="#246BFE" />
                <Button x:Name="TryAgainButton" Margin="0,8,0,0" Height="36" Content="Try again" Click="TryAgainButton_Click" Background="#1F2937" Foreground="White" BorderBrush="#1F2937" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
