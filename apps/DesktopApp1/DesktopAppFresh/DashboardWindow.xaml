<Window x:Class="DesktopAppFresh.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project X - Dashboard"
        Width="1200"
        Height="700"
        MinWidth="1100"
        MinHeight="660"
        Background="#F5F7FB"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#0B1C30"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#246BFE"/>
        <SolidColorBrush x:Key="BluePaleBrush" Color="#E8EFFF"/>
        <SolidColorBrush x:Key="InkBrush" Color="#102136"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#718096"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E4EAF2"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CanvasBrush" Color="#F5F7FB"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#16845A"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#C93630"/>


        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#DFF2FF" Offset="0"/>
            <GradientStop Color="#C5DDFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="700"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Project X.png" Width="34" Height="34" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="PROJECT X"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="19"
                               FontWeight="700"
                               Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="InternetStatusBadge" Background="#FFF7E6" CornerRadius="999" Padding="8,5" Margin="0,0,18,0" ToolTip="Live internet connectivity status">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="InternetStatusDot" Width="8" Height="8" Fill="#C98A00"/>
                            <TextBlock x:Name="InternetStatusText" Text="Checking internet..." FontFamily="{StaticResource BodyFont}" FontSize="11" FontWeight="700" Foreground="#9A6700" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Workspace / Overview"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="12"
                               FontWeight="600"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Margin="24,38,24,44" HorizontalAlignment="Stretch">
                <Grid MaxWidth="1320" Margin="0,0,0,20" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="GreetingText" Text="Welcome."
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="38"
                               FontWeight="600"
                               Foreground="{StaticResource InkBrush}"
                               Margin="0,0,0,0"/>

                    <TextBlock x:Name="CurrentDateText" Grid.Column="1"
                               Text=""
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Bottom"/>
                </Grid>

                <Grid MaxWidth="1320" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource HeroGradient}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="30" CornerRadius="12" MinHeight="290" Margin="0,0,20,0" ClipToBounds="True">
                        <Grid>
                            <Ellipse Width="330" Height="330" Fill="#FFFFFF" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-90,0"/>
                            <Ellipse Width="330" Height="330" Stroke="#246BFE" StrokeThickness="48" Opacity="0.08" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-90,0"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="48" Height="5" Fill="#F4D84F" RadiusX="4" RadiusY="4" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                                <TextBlock Text="Time remaining"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="30"
                                           FontWeight="700"
                                           Foreground="{StaticResource InkBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,24"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Width="70" Height="80" Background="#FFFFFF" BorderBrush="#E8ECF0" BorderThickness="1" Margin="0,0,10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="DaysBox" Text="--" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="700" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Days" FontFamily="{StaticResource BodyFont}" FontSize="9" FontWeight="700" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="70" Height="80" Background="#FFFFFF" BorderBrush="#E8ECF0" BorderThickness="1" Margin="0,0,10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="HoursBox" Text="--" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="700" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Hrs" FontFamily="{StaticResource BodyFont}" FontSize="9" FontWeight="700" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="70" Height="80" Background="#FFFFFF" BorderBrush="#E8ECF0" BorderThickness="1" Margin="0,0,10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="MinsBox" Text="--" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="700" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Mins" FontFamily="{StaticResource BodyFont}" FontSize="9" FontWeight="700" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="70" Height="80" Background="#FFFFFF" BorderBrush="#E8ECF0" BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="SecsBox" Text="--" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="700" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Secs" FontFamily="{StaticResource BodyFont}" FontSize="9" FontWeight="700" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="24" CornerRadius="12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Permanent license" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="600" Foreground="{StaticResource InkBrush}"/>
                                <Border Grid.Column="1" Background="#E6F6EF" CornerRadius="5" Padding="6,4">
                                    <TextBlock x:Name="PermanentLicenseAvailabilityText" Text="Checking" FontFamily="{StaticResource BodyFont}" FontSize="10" FontWeight="700" Foreground="{StaticResource GreenBrush}"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Unlock lifetime access to Project X on your registered device."
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,18"/>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="0,13" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="License price" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="PermanentLicensePriceText" Text="Unavailable" Grid.Column="1" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="700" Foreground="{StaticResource InkBrush}"/>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Current status" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="PermanentLicenseStatusText" Text="Checking" Grid.Column="1" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Button x:Name="OpenPermanentPaymentBtn"
                                    Style="{StaticResource DashboardButton}"
                                    Height="40"
                                    Content="Make payment"
                                    Click="OpenPermanentPaymentBtn_Click"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LicenseKeyBox"
                                         Height="40"
                                         Padding="11,0"
                                         BorderBrush="{StaticResource LineBrush}"
                                         BorderThickness="1"
                                         Background="#FBFCFE"
                                         FontFamily="{StaticResource BodyFont}"
                                         FontSize="12"
                                         Foreground="{StaticResource MutedBrush}"
                                         VerticalContentAlignment="Center"
                                         Text="XXXXXXXXXX"
                                         GotFocus="LicenseKeyBox_GotFocus"
                                         LostFocus="LicenseKeyBox_LostFocus"/>
                                <Button x:Name="VerifyPermanentBtn"
                                        Grid.Column="1"
                                        Style="{StaticResource DashboardButton}"
                                        Height="40"
                                        MinWidth="64"
                                        Margin="8,0,0,0"
                                        Content="Verify"
                                        Click="VerifyPermanentBtn_Click"/>
                            </Grid>

                            <TextBlock x:Name="VerifyStatusText"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                            <TextBlock x:Name="StatusText" Text="" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid MaxWidth="1320" Margin="0,20,0,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,20,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Installment plan" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="600" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock x:Name="PlanFrequencyText" Grid.Column="1" Text="Unavailable" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,18,0,0" Padding="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Installment amount" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="AmountText" Text="Unavailable" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="700" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="InstallmentPlanText" Text="Unavailable" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="Contract ID" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="ContractNumberText" Text="Unavailable" FontFamily="{StaticResource BodyFont}" FontSize="14" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="CancelPlanBtn" Style="{StaticResource DashboardButton}" Height="42" Margin="0,22,0,0" Content="Cancel plan" Background="{StaticResource WarningBrush}" Click="CancelPlanBtn_Click"/>
                            <TextBlock x:Name="CancellationStatusText" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,20,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="BalanceText" Text=""/>
                            <TextBlock x:Name="BalanceAmountText" Text=""/>
                            <TextBlock x:Name="PaidAmountText" Text=""/>
                            <TextBlock x:Name="ProgressPercentText" Text=""/>
                            <Border x:Name="PaidProgressBar" Width="0" Height="0"/>
                            <TextBlock x:Name="NextPaymentText" Text=""/>
                            <Button x:Name="VerifyLicenseBtn" Width="0" Height="0" Visibility="Collapsed" Click="VerifyLicenseBtn_Click"/>
                            <Border x:Name="PermanentLicensePanel" Visibility="Collapsed">
                                <TextBlock x:Name="PermanentLicenseText" Text=""/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,20,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="NoticeTitle" Text="Important"/>
                            <TextBlock x:Name="NoticeBody" Text=""/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,20,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Recent activity" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="600" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Grid.Column="1" Text="All activity" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Margin="0,18,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Border Width="30" Height="30" Background="{StaticResource BluePaleBrush}" BorderBrush="#B9CCF8" BorderThickness="1" CornerRadius="7" Margin="0,0,12,0">
                                        <TextBlock Text="01" FontFamily="{StaticResource BodyFont}" FontSize="11" FontWeight="700" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Payment received" FontFamily="{StaticResource BodyFont}" FontSize="12" FontWeight="700" Foreground="{StaticResource InkBrush}"/>
                                        <TextBlock x:Name="PaymentActivityDetailsText" Text="No payment activity available." FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Border Width="30" Height="30" Background="{StaticResource BluePaleBrush}" BorderBrush="#B9CCF8" BorderThickness="1" CornerRadius="7" Margin="0,0,12,0">
                                        <TextBlock Text="02" FontFamily="{StaticResource BodyFont}" FontSize="11" FontWeight="700" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Plan activated" FontFamily="{StaticResource BodyFont}" FontSize="12" FontWeight="700" Foreground="{StaticResource InkBrush}"/>
                                        <TextBlock x:Name="PlanActivityDetailsText" Text="No plan activity available." FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" Background="{StaticResource BluePaleBrush}" BorderBrush="#B9CCF8" BorderThickness="1" CornerRadius="7" Margin="0,0,12,0">
                                        <TextBlock Text="03" FontFamily="{StaticResource BodyFont}" FontSize="11" FontWeight="700" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Device registered" FontFamily="{StaticResource BodyFont}" FontSize="12" FontWeight="700" Foreground="{StaticResource InkBrush}"/>
                                        <TextBlock x:Name="RegistrationActivityDetailsText" Text="No registration details available." FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Device information" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="600" Foreground="{StaticResource InkBrush}"/>
                                <Border Grid.Column="1" Background="#E6F6EF" Padding="6,4" CornerRadius="5">
                                    <TextBlock x:Name="DeviceStatusText" Text="Checking" FontFamily="{StaticResource BodyFont}" FontSize="10" FontWeight="700" Foreground="{StaticResource GreenBrush}"/>
                                </Border>
                            </Grid>

                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Text="Device name" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="DeviceNameText" Text="Unavailable" FontFamily="{StaticResource BodyFont}" FontSize="14" FontWeight="700" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="Operating system" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="OperatingSystemText" Text="Unavailable" FontFamily="{StaticResource BodyFont}" FontSize="14" FontWeight="700" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="Device ID" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="DeviceIdValueText" Text="Unavailable" FontFamily="{StaticResource BodyFont}" FontSize="14" FontWeight="700" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="© 2024 PROJECT X PAY-AS-YOU-GO SYSTEMS." FontFamily="{StaticResource BodyFont}" FontSize="12" FontWeight="700" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="LEGAL_INFRASTRUCTURE" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
